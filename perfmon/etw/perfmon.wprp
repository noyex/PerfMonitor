<?xml version="1.0" encoding="utf-8"?>
<!-- PerfMonitor ETW black box: kernel DPC/ISR, image loads (routine -> driver), disk I/O, processes/threads in a
     circular in-memory buffer. etwbox.py writes a copy with Buffers = etw.buffer_mb (1 MB buffers) and starts it with
     wpr -start <copy>!PerfMonBox -instancename PerfMonBox. CSwitch is left out on purpose (overhead). -->
<WindowsPerformanceRecorder Version="1.0" Author="PerfMonitor">
  <Profiles>
    <SystemCollector Id="SC_PerfMonBox" Name="PerfMonBox Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="256"/>
    </SystemCollector>
    <SystemProvider Id="SP_PerfMonBox">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="Interrupt"/>
        <Keyword Value="DPC"/>
        <Keyword Value="DiskIO"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="PerfMonBox.Verbose.Memory" Name="PerfMonBox" Description="PerfMonitor ETW black box"
             LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC_PerfMonBox">
          <SystemProviderId Value="SP_PerfMonBox"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
